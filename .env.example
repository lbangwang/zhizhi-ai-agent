# 复制为 .env 后填入真实值（.env 已被 gitignore，不要提交）
# cp .env.example .env

# ---------- 大模型 ----------
# 通义千问 / DashScope（百炼）
DASHSCOPE_API_KEY=

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 豆包 / 火山方舟
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-1-turbo-260628

# Ollama（本地，可选；云服务器一般不装，勿开启 startup-probe）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b
# 启动时探测 Ollama（默认 false；为 true 且本机无 Ollama 会导致启动失败）
APP_OLLAMA_STARTUP_PROBE=false

# ---------- 工具 ----------
# SearchAPI.io（超级智能体网页搜索）
SEARCH_API_KEY=

# ---------- 服务 ----------
SERVER_PORT=8123

# ---------- MySQL（本地部署后） ----------
# 未部署前保持 false，应用可不连库启动
MYSQL_ENABLED=false
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/zhizhi_ai_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=
# 启用 MySQL 后请先执行: src/main/resources/db/schema.sql

# Sa-Token JWT 签名密钥（生产务必更换）
SA_TOKEN_JWT_SECRET=zhizhi-ai-agent-dev-jwt-secret-change-me

# ---------- Redis（D5 停止信号） ----------
# 本地已部署 Redis 后设为 true；也可用 docker compose up -d 启动
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- 知识库 / VectorStore（W2） ----------
# 向量库当前使用 Spring AI SimpleVectorStore（本地 JSON 文件持久化）
KNOWLEDGE_FILE_DIR=data/knowledge-files
KNOWLEDGE_VECTOR_STORE_FILE=data/vector-store/knowledge-simple.json
KNOWLEDGE_SEED_CLASSPATH=true
# 入库 embedding 批量大小（默认 16；越大越快，通义建议 ≤25）
# KNOWLEDGE_EMBED_BATCH_SIZE=16
# 切片策略：paragraph（按段，推荐）| token（按 token）
KNOWLEDGE_SPLIT_STRATEGY=paragraph
# paragraph 时单段最大字符数，0=自动（约 chunk-token-size*2）
# KNOWLEDGE_PARAGRAPH_MAX_CHARS=800
# 是否额外启用百炼云知识库顾问（默认关，优先本地 VectorStore）
KNOWLEDGE_CLOUD_RAG_ENABLED=false

# ---------- W3：HITL / MCP / Trace / Pexels ----------
# 危险工具确认超时（秒）
HITL_TIMEOUT_SECONDS=120
# 开启后主应用作为 MCP Client，连接 mcp-servers.json 中的 image-search（需先 mvn package MCP 模块）
MCP_ENABLED=false
MCP_MERGE_TOOLS=true
# 本地图片搜索兜底（MCP 未启用或无 searchImage 时）；https://www.pexels.com/api/
PEXELS_API_KEY=
