# 复制为 .env 后按需修改
# cp .env.example .env

# 本地开发：留空，走 Vite 代理 /api -> http://localhost:8123（同域，避免 CORS 预检问题）
# 直连后端或云端时再填写，例如：
# VITE_API_BASE=http://localhost:8123
# VITE_API_BASE=https://zhizhi-ai-agent-xxx.sh.run.tcloudbase.com
VITE_API_BASE=

# 是否显示注册入口（需与后端 AUTH_REGISTER_ENABLED 一致）
# 云端演示 / 防刷 Token：false；本地要自测注册时改为 true
VITE_AUTH_REGISTER_ENABLED=false
